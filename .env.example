# Supabase → Project Settings → API
# A service role só pode existir no servidor. Não use o prefixo NEXT_PUBLIC_ nela.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago → Suas integrações → credenciais de produção (ou de teste).
# A public key pode ir ao navegador. O access token fica só no servidor.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
# Segredo da assinatura do webhook, em Suas integrações → Webhooks.
MERCADO_PAGO_WEBHOOK_SECRET=
# URL pública https da loja, sem barra no final.
# O aviso de pagamento é {URL}/api/payments/webhook
NEXT_PUBLIC_SITE_URL=

# Acesso da equipe. Não use o prefixo NEXT_PUBLIC_.
# A senha precisa ter pelo menos 12 caracteres.
# ADMIN_SESSION_SECRET precisa ter pelo menos 32 caracteres aleatórios.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
